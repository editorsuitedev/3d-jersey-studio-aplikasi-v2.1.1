{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in 3D Jersey Studio",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Full name of the user",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the user",
          "maxLength": 255
        },
        "avatar": {
          "type": "string",
          "description": "Avatar image URL or empty string",
          "maxLength": 1024
        },
        "passwordHash": {
          "type": "string",
          "description": "Hashed password for email auth (if applicable)",
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "name", "email", "createdAt", "updatedAt"]
    },
    "JerseyProject": {
      "title": "JerseyProject",
      "description": "Saved 3D Jersey design preset and configuration",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the jersey project",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user identifier",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Project title",
          "minLength": 1,
          "maxLength": 120
        },
        "modelId": {
          "type": "string",
          "description": "Associated 3D model ID",
          "maxLength": 64
        },
        "baseColor": {
          "type": "string",
          "description": "Jersey primary color hex",
          "maxLength": 16
        },
        "accentColor": {
          "type": "string",
          "description": "Jersey accent color hex",
          "maxLength": 16
        },
        "collarColor": {
          "type": "string",
          "description": "Jersey collar color hex",
          "maxLength": 16
        },
        "sleeveColor": {
          "type": "string",
          "description": "Jersey sleeve color hex",
          "maxLength": 16
        },
        "pattern": {
          "type": "string",
          "description": "Jersey pattern identifier",
          "maxLength": 64
        },
        "roughness": {
          "type": "number",
          "description": "PBR material roughness"
        },
        "metalness": {
          "type": "number",
          "description": "PBR material metalness"
        },
        "fabricSheen": {
          "type": "number",
          "description": "PBR fabric sheen factor"
        },
        "layersCount": {
          "type": "number",
          "description": "Number of visual layers in the design"
        },
        "previewUrl": {
          "type": "string",
          "description": "Thumbnail preview image data URL or empty string",
          "maxLength": 100000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "userId", "name", "modelId", "baseColor", "createdAt", "updatedAt"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Document used to verify connectivity to Firestore",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Connection test status indicator"
        }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/users/{userId}/jerseys/{jerseyId}": {
      "schema": "JerseyProject",
      "description": "Saved 3D jersey designs for each authenticated user"
    },
    "/test/{docId}": {
      "schema": "TestConnection",
      "description": "Health check document for Firestore connection validation"
    }
  }
}
