rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for User
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.email is string && data.email.size() <= 255 &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 1024)) &&
        (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 256));
    }

    // Validation helper for JerseyProject
    function isValidJersey(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'modelId', 'baseColor', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.modelId is string && data.modelId.size() <= 64 &&
        data.baseColor is string && data.baseColor.size() <= 16 &&
        (!('accentColor' in data) || (data.accentColor is string && data.accentColor.size() <= 16)) &&
        (!('collarColor' in data) || (data.collarColor is string && data.collarColor.size() <= 16)) &&
        (!('sleeveColor' in data) || (data.sleeveColor is string && data.sleeveColor.size() <= 16)) &&
        (!('pattern' in data) || (data.pattern is string && data.pattern.size() <= 64)) &&
        (!('roughness' in data) || data.roughness is number) &&
        (!('metalness' in data) || data.metalness is number) &&
        (!('fabricSheen' in data) || data.fabricSheen is number) &&
        (!('layersCount' in data) || data.layersCount is number) &&
        (!('previewUrl' in data) || (data.previewUrl is string && data.previewUrl.size() <= 100000));
    }

    // Test connection document for initial boot probe
    match /test/{docId} {
      allow get: if true;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Blanket user listing forbidden

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUser(incoming()) &&
        incoming().id == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUser(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'avatar', 'passwordHash', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // User saved jerseys subcollection
      match /jerseys/{jerseyId} {
        allow get: if isOwner(userId) && isValidId(jerseyId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isValidId(jerseyId) &&
          isValidJersey(incoming()) &&
          incoming().userId == userId &&
          incoming().id == jerseyId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;

        allow update: if isOwner(userId) &&
          isValidId(jerseyId) &&
          isValidJersey(incoming()) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'modelId', 'baseColor', 'accentColor', 'collarColor', 'sleeveColor',
            'pattern', 'roughness', 'metalness', 'fabricSheen', 'layersCount', 'previewUrl', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isValidId(jerseyId);
      }
    }
  }
}
